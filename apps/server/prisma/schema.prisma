generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  passwordHash String?
  displayName  String
  createdAt    DateTime @default(now())

  hostedRooms  Room[]        @relation("RoomHost")
  participants Participant[]

  @@map("users")
}

model Room {
  id   String  @id @default(cuid())
  code String  @unique
  name String?

  hostUserId String?
  hostUser   User?   @relation("RoomHost", fields: [hostUserId], references: [id], onDelete: SetNull)

  youtubeAccessToken    String?
  youtubeRefreshToken   String?
  youtubeTokenExpiresAt DateTime?
  youtubePlaylistId     String?

  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  // Queue order defaults to vote score. A host drag-reorder switches this on,
  // making `QueueItem.position` the source of truth instead; a host vote
  // switches it back off, handing ordering back to the votes.
  manualQueueOrder Boolean @default(false)

  participants Participant[] @relation("RoomParticipants")
  queueItems   QueueItem[]   @relation("RoomQueueItems")

  @@index([lastActiveAt])
  @@map("rooms")
}

model Participant {
  id     String @id @default(cuid())
  roomId String
  room   Room   @relation("RoomParticipants", fields: [roomId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  guestName String?
  isHost    Boolean  @default(false)
  joinedAt  DateTime @default(now())

  addedQueueItems QueueItem[] @relation("QueueItemAddedBy")
  votes           Vote[]

  // Lets an authenticated user's participant identity be looked up and
  // reused across devices/reconnects instead of spawning a duplicate row.
  // Multiple NULLs (guests) are unaffected: Postgres unique indexes don't
  // consider NULL values equal to each other.
  @@unique([roomId, userId])
  @@map("participants")
}

model QueueItem {
  id     String @id @default(cuid())
  roomId String
  room   Room   @relation("RoomQueueItems", fields: [roomId], references: [id], onDelete: Cascade)

  youtubeVideoId        String
  title                 String
  thumbnailUrl          String?
  youtubePlaylistItemId String?

  addedByParticipantId String?
  addedBy              Participant? @relation("QueueItemAddedBy", fields: [addedByParticipantId], references: [id], onDelete: SetNull)

  score     Int       @default(0)
  // Explicit play-order, independent of score. Appended items get
  // max(position)+1; host reorder rewrites every item's position in the room.
  position  Int       @default(0)
  playedAt  DateTime?
  createdAt DateTime  @default(now())

  votes Vote[]

  @@index([roomId])
  @@map("queue_items")
}

model Vote {
  id String @id @default(cuid())

  queueItemId String
  queueItem   QueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)

  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  value     Int
  createdAt DateTime @default(now())

  @@unique([queueItemId, participantId])
  @@map("votes")
}
